{
  "manifest_version": 3,
  "name": "Venda em Dia • WhatsApp",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "description": "Acompanhamento ativado por você na conversa aberta, sugestões de texto e voz por IA via servidor local.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Abrir Venda em Dia"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}