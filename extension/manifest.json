{
  "manifest_version": 3,
  "name": "Venda em Dia • WhatsApp",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "description": "Painel lateral que importa, por botão, mensagens de texto carregadas na conversa aberta no WhatsApp Web.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Abrir Venda em Dia"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}